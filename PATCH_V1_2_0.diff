+    const snapshot = sessionStore?.getUserSnapshot ? await sessionStore.getUserSnapshot(key) : null;
+    const cached = snapshot?.rows || [];
+    const since = cached.length ? snapshot?.metadata?.lastSyncAt || null : null;
